<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>FileManagerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Grants access to the Folder Upload / File Manager feature: FileManagerController Apex class plus Folder__c object and field access. File CRUD relies on the user's standard Files license access.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>Folder__c.ParentFolder__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Folder__c.RecordId__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>File Manager Access</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Folder__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
